# .env 로 복사해서 값을 채운다. 이 파일은 키 목록만 공유하는 용도다.
#   cp .env.example .env
#
# 비밀이 아닌 설정(DB_HOST, DB_PORT, DB_NAME, STORAGE_TYPE 등)은
# application.yaml 에 로컬 기본값이 들어 있어 따로 지정하지 않아도 된다.

# 로컬 MySQL 계정 비밀번호
DB_PASSWORD=

# JWT HS256 서명 키. 최소 32바이트여야 하며 아니면 기동에 실패한다
JWT_SECRET=

# 로컬 Redis 에 비밀번호가 없으면 비워 둔다
REDIS_PASSWORD=

# SMTP 앱 비밀번호 (API-004 인증번호 발송)
MAIL_PASSWORD=

# 로컬 MySQL 계정
DB_USERNAME=
